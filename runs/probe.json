  "zodTools": [
    {
      "name": "count_devices",
      "description": "Count the devices matching a set of filters. Returns only a number. Use this to size a group before asking for rows, since listing tools are capped.",
      "input_schema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "InfusaLine 400",
              "InfusaLine 700",
              "CardioTrack M5",
              "Aeris V3",
              "RenalPure D2"
            ]
          },
          "site": {
            "description": "Facility code.",
            "type": "string",
            "enum": [
              "BRD",
              "CHC",
              "EVN",
              "LKV",
              "NGH",
              "PDM",
              "STM",
              "WRC"
            ]
          },
          "firmware": {
            "description": "Exact firmware version, e.g. 4.0.1.",
            "type": "string"
          },
          "min_hours": {
            "description": "Inclusive lower bound on operating_hours.",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "max_hours": {
            "description": "Exclusive upper bound on operating_hours.",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "top_devices",
      "description": "The highest devices by a single stored field, subject to filters. Returns at most 10 rows of {device_id, model, <field>}. Only stored fields can be ranked: operating_hours, alerts, risk_score (the vendor failure-risk score, 1 to 99, assigned in advance), downtime_min (unplanned downtime in minutes over the window). Derived quantities such as downtime per operating hour are not available here.",
      "input_schema": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "enum": [
              "operating_hours",
              "alerts",
              "risk_score",
              "downtime_min"
            ],
            "description": "The field to rank by, highest first."
          },
          "limit": {
            "description": "How many rows to return, 1 to 10. Defaults to 5.",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "model": {
            "type": "string",
            "enum": [
              "InfusaLine 400",
              "InfusaLine 700",
              "CardioTrack M5",
              "Aeris V3",
              "RenalPure D2"
            ]
          },
          "site": {
            "description": "Facility code.",
            "type": "string",
            "enum": [
              "BRD",
              "CHC",
              "EVN",
              "LKV",
              "NGH",
              "PDM",
              "STM",
              "WRC"
            ]
          },
          "firmware": {
            "description": "Exact firmware version, e.g. 4.0.1.",
            "type": "string"
          },
          "min_hours": {
            "description": "Inclusive lower bound on operating_hours.",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "max_hours": {
            "description": "Exclusive upper bound on operating_hours.",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "field"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_device",
      "description": "The full record for one device: model, site, firmware, operating_hours, alerts, risk_score, downtime_min.",
      "input_schema": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string",
            "description": "The device id, e.g. IL4-007."
          }
        },
        "required": [
          "device_id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ],
